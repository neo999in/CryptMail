+    // The certificate's subjectAltName dNSName entries (type 2), which are what
+    // names a TLS server (RFC 6125); the subject CN alone is not.
+    private static WritableArray getDnsNames(X509Certificate cert) throws CertificateParsingException {
+        WritableArray out = Arguments.createArray();
+        Collection<List<?>> names = cert.getSubjectAlternativeNames();
+        if (names == null) return out;
+        for (List<?> entry : names) {
+            if (entry.size() >= 2 && Integer.valueOf(2).equals(entry.get(0)) && entry.get(1) instanceof String) {
+                out.pushString((String) entry.get(1));
+            }
+        }
+        return out;
+    }
